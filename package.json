{
  "name": "kalinga-ai-fullstack",
  "version": "1.0.0",
  "description": "Full-stack offline-first maternal triage workflow prototype",
  "main": "server/src/index.js",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "start:server": "npm start --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "grape-context": "^1.0.0-beta.9"
  }
}
